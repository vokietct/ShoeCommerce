@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable

<div class="admin-wrapper">
    <!-- Admin Sidebar -->
    <aside class="admin-sidebar">
        <div class="sidebar-header">
            <a href="/admin" class="sidebar-logo">
                shoestore<span class="dot">.</span>
            </a>
            <div>
                @if (AuthService.IsAdmin)
                {
                    <span class="role-badge">Quản lý · Admin</span>
                }
                else if (AuthService.IsEmployee)
                {
                    <span class="role-badge employee">Nhân viên</span>
                }
            </div>
            <div class="small text-white mt-2 fw-semibold">
                @(AuthService.CurrentUser?.FullName ?? "Chưa đăng nhập")
            </div>
            <div class="small text-secondary" style="font-size: 0.75rem;">
                01 cửa hàng · 01 kho chung
            </div>
        </div>

        <ul class="sidebar-menu">
            @if (AuthService.IsAdmin)
            {
                <li class="menu-category">Tổng quan & Phân tích</li>
                <li class="sidebar-item">
                    <NavLink href="/admin" Match="NavLinkMatch.All">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Tổng quan</span>
                    </NavLink>
                </li>
                <li class="sidebar-item">
                    <NavLink href="/admin/statistics">
                        <i class="bi bi-graph-up-arrow"></i>
                        <span>Thống kê</span>
                    </NavLink>
                </li>

                <li class="menu-category">Bán hàng & Đơn hàng</li>
                <li class="sidebar-item">
                    <NavLink href="/admin/orders">
                        <i class="bi bi-bag-check-fill"></i>
                        <span>Quản lý đơn hàng</span>
                    </NavLink>
                </li>
                <li class="sidebar-item">
                    <NavLink href="/admin/payments">
                        <i class="bi bi-credit-card-fill"></i>
                        <span>Thanh toán</span>
                    </NavLink>
                </li>

                <li class="menu-category">Sản phẩm & Kho</li>
                <li class="sidebar-item">
                    <NavLink href="/admin/products">
                        <i class="bi bi-box-seam-fill"></i>
                        <span>Sản phẩm</span>
                    </NavLink>
                </li>
                <li class="sidebar-item">
                    <NavLink href="/admin/categories-brands">
                        <i class="bi bi-tags-fill"></i>
                        <span>Danh mục & Thương hiệu</span>
                    </NavLink>
                </li>
                <li class="sidebar-item">
                    <NavLink href="/admin/inventory">
                        <i class="bi bi-archive-fill"></i>
                        <span>Tồn kho</span>
                    </NavLink>
                </li>
                <li class="sidebar-item">
                    <NavLink href="/admin/stock-documents">
                        <i class="bi bi-file-earmark-text-fill"></i>
                        <span>Phiếu nhập / xuất kho</span>
                    </NavLink>
                </li>
                <li class="sidebar-item">
                    <NavLink href="/admin/suppliers">
                        <i class="bi bi-truck"></i>
                        <span>Nhà cung cấp</span>
                    </NavLink>
                </li>

                <li class="menu-category">Khách hàng & Tiếp thị</li>
                <li class="sidebar-item">
                    <NavLink href="/admin/customers">
                        <i class="bi bi-people-fill"></i>
                        <span>Khách hàng</span>
                    </NavLink>
                </li>
                <li class="sidebar-item">
                    <NavLink href="/admin/promotions">
                        <i class="bi bi-ticket-perforated-fill"></i>
                        <span>Khuyến mãi</span>
                    </NavLink>
                </li>
                <li class="sidebar-item">
                    <NavLink href="/admin/reviews">
                        <i class="bi bi-star-fill"></i>
                        <span>Đánh giá sản phẩm</span>
                    </NavLink>
                </li>

                <li class="menu-category">Hệ thống</li>
                <li class="sidebar-item">
                    <NavLink href="/admin/employees">
                        <i class="bi bi-person-badge-fill"></i>
                        <span>Nhân viên</span>
                    </NavLink>
                </li>
            }
            else if (AuthService.IsEmployee)
            {
                <li class="menu-category">Không gian làm việc</li>
                <li class="sidebar-item">
                    <NavLink href="/admin" Match="NavLinkMatch.All">
                        <i class="bi bi-laptop"></i>
                        <span>Bàn làm việc</span>
                    </NavLink>
                </li>
                <li class="sidebar-item">
                    <NavLink href="/admin/orders">
                        <i class="bi bi-bag-check-fill"></i>
                        <span>Xử lý đơn hàng</span>
                    </NavLink>
                </li>
                <li class="sidebar-item">
                    <NavLink href="/admin/payments">
                        <i class="bi bi-credit-card-fill"></i>
                        <span>Xác nhận thanh toán</span>
                    </NavLink>
                </li>

                <li class="menu-category">Tra cứu thông tin</li>
                <li class="sidebar-item">
                    <NavLink href="/admin/products">
                        <i class="bi bi-box-seam-fill"></i>
                        <span>Tra cứu sản phẩm</span>
                    </NavLink>
                </li>
                <li class="sidebar-item">
                    <NavLink href="/admin/inventory">
                        <i class="bi bi-archive-fill"></i>
                        <span>Tra cứu tồn kho</span>
                    </NavLink>
                </li>
                <li class="sidebar-item">
                    <NavLink href="/admin/customers">
                        <i class="bi bi-people-fill"></i>
                        <span>Tra cứu khách hàng</span>
                    </NavLink>
                </li>
            }
        </ul>

        <div class="p-3 border-top border-secondary border-opacity-25">
            <a href="/" class="btn btn-sm btn-outline-light w-100 mb-2">
                <i class="bi bi-shop me-1"></i> Xem Cửa Hàng
            </a>
            <button @onclick="HandleLogout" class="btn btn-sm btn-danger w-100">
                <i class="bi bi-box-arrow-right me-1"></i> Đăng Xuất
            </button>
        </div>
    </aside>

    <!-- Admin Main Body -->
    <div class="admin-main">
        <header class="admin-topbar">
            <div class="d-flex align-items-center gap-3">
                <div class="badge bg-light text-dark border px-2 py-1">
                    <i class="bi bi-building me-1"></i> Kho chung ShoeStore
                </div>
                <div class="text-secondary small">
                    <i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy")
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="text-end">
                    <div class="fw-semibold small text-dark">@(AuthService.CurrentUser?.FullName ?? "Quản trị viên")</div>
                    <div class="text-secondary" style="font-size: 0.75rem;">@(AuthService.CurrentUser?.Email ?? "")</div>
                </div>
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                    @(AuthService.CurrentUser?.FullName?.FirstOrDefault() ?? 'A')
                </div>
            </div>
        </header>

        <main class="admin-content">
            @Body
        </main>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += StateHasChanged;
        CheckAccess();
    }

    private void CheckAccess()
    {
        // Kiểm tra xem đã đăng nhập và có quyền Admin/Employee chưa
        if (!AuthService.IsAuthenticated || !AuthService.IsAdminOrEmployee)
        {
            Navigation.NavigateTo("/admin/login");
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/admin/login");
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= StateHasChanged;
    }
}

