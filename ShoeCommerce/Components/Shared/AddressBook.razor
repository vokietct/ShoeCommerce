@inject IUserService UserService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="container py-4" style="max-width: 900px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">@(ManagedCustomerId.HasValue ? "Sổ địa chỉ khách hàng" : "Sổ địa chỉ của tôi")</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-geo-alt me-2 text-danger"></i> Sổ Địa Chỉ Giao Hàng
            </h3>
            <p class="text-secondary small mb-0">Quản lý danh sách địa chỉ nhận hàng để thanh toán nhanh chóng hơn</p>
        </div>
        <button class="btn btn-dark btn-sm rounded-pill px-3 fw-semibold" @onclick="OpenAddModal">
            <i class="bi bi-plus-lg me-1"></i> Thêm Địa Chỉ Mới
        </button>
    </div>

    @if (!AuthService.IsAuthenticated || !CanManage)
    {
        <div class="bg-white rounded-4 border p-5 text-center my-4">
            <i class="bi bi-person-lock fs-1 text-secondary mb-3 d-block"></i>
            <h5 class="fw-bold">Vui lòng đăng nhập để quản lý địa chỉ</h5>
            <a href="/login" class="btn btn-dark rounded-pill px-4 mt-2">Đăng Nhập</a>
        </div>
    }
    else if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Đang tải sổ địa chỉ...</p>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(alertMessage))
        {
            <div class="alert @(alertSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show rounded-3 small mb-4" role="alert">
                <i class="bi @(alertSuccess ? "bi-check-circle" : "bi-exclamation-triangle") me-1"></i>
                @alertMessage
                <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
            </div>
        }

        @if (addresses == null || !addresses.Any())
        {
            <div class="bg-white rounded-4 border p-5 text-center">
                <i class="bi bi-geo fs-1 text-secondary mb-3 d-block"></i>
                <h5 class="fw-bold">Chưa có địa chỉ giao hàng nào</h5>
                <p class="text-secondary small">Hãy thêm địa chỉ nhận hàng đầu tiên để dễ dàng đặt hàng nhé!</p>
                <button class="btn btn-dark rounded-pill px-4 mt-2" @onclick="OpenAddModal">
                    + Thêm Địa Chỉ Đầu Tiên
                </button>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var addr in addresses)
                {
                    <div class="col-md-6">
                        <div class="bg-white rounded-4 border p-4 h-100 position-relative shadow-sm d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-dark mb-0">@addr.ReceiverName</h6>
                                    @if (addr.IsDefault)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle small">
                                            <i class="bi bi-check2 me-1"></i> Mặc định
                                        </span>
                                    }
                                </div>
                                <div class="text-secondary small mb-2">
                                    <i class="bi bi-telephone me-1"></i> @addr.Phone
                                </div>
                                <div class="text-dark small mb-3">
                                    <i class="bi bi-pin-map me-1 text-danger"></i> @addr.AddressLine
                                </div>
                            </div>

                            <div class="border-top pt-3 d-flex justify-content-between align-items-center">
                                <div>
                                    @if (!addr.IsDefault)
                                    {
                                        <button class="btn btn-sm btn-link p-0 text-primary text-decoration-none small" @onclick="() => SetDefault(addr.AddressId)">
                                            Đặt làm mặc định
                                        </button>
                                    }
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="() => OpenEditModal(addr)">
                                        <i class="bi bi-pencil me-1"></i> Sửa
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="() => DeleteAddress(addr.AddressId)">
                                        <i class="bi bi-trash me-1"></i> Xóa
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<!-- Modal Thêm / Sửa Địa Chỉ -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold">
                        @(isEditing ? "Chỉnh Sửa Địa Chỉ" : "Thêm Địa Chỉ Mới")
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Họ tên người nhận <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="formReceiver" placeholder="Nguyễn Văn A" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="formPhone" placeholder="0901234567" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Địa chỉ chi tiết <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="3" @bind="formAddress" placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố"></textarea>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chkDefault" @bind="formIsDefault" />
                        <label class="form-check-label small" for="chkDefault">
                            Đặt làm địa chỉ nhận hàng mặc định
                        </label>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="() => showModal = false">Hủy</button>
                    <button type="button" class="btn btn-dark btn-sm rounded-pill px-4" @onclick="SaveAddress">
                        Lưu Địa Chỉ
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? ManagedCustomerId { get; set; }
    private int EffectiveCustomerId => ManagedCustomerId ?? AuthService.CurrentUser?.UserId ?? 0;
    private bool CanManage => ManagedCustomerId.HasValue ? AuthService.IsAdmin : AuthService.IsCustomer;

    private List<CustomerAddress>? addresses;
    private bool isLoading = true;

    private string? alertMessage;
    private bool alertSuccess = true;

    private bool showModal = false;
    private bool isEditing = false;
    private int currentEditId = 0;

    private string formReceiver = "";
    private string formPhone = "";
    private string formAddress = "";
    private bool formIsDefault = false;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAddresses();
    }

    private async Task LoadAddresses()
    {
        if (AuthService.IsAuthenticated && CanManage && AuthService.CurrentUser != null)
        {
            isLoading = true;
            addresses = await UserService.GetCustomerAddressesAsync(EffectiveCustomerId);
            isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        isEditing = false;
        currentEditId = 0;
        formReceiver = ManagedCustomerId.HasValue ? "" : AuthService.CurrentUser?.FullName ?? "";
        formPhone = ManagedCustomerId.HasValue ? "" : AuthService.CurrentUser?.Phone ?? "";
        formAddress = "";
        formIsDefault = (addresses == null || !addresses.Any());
        showModal = true;
    }

    private void OpenEditModal(CustomerAddress addr)
    {
        isEditing = true;
        currentEditId = addr.AddressId;
        formReceiver = addr.ReceiverName;
        formPhone = addr.Phone;
        formAddress = addr.AddressLine;
        formIsDefault = addr.IsDefault;
        showModal = true;
    }

    private async Task SaveAddress()
    {
        if (AuthService.CurrentUser == null) return;

        if (string.IsNullOrWhiteSpace(formReceiver) || string.IsNullOrWhiteSpace(formPhone) || string.IsNullOrWhiteSpace(formAddress))
        {
            alertSuccess = false;
            alertMessage = "Vui lòng nhập đầy đủ họ tên, số điện thoại và địa chỉ.";
            return;
        }

        if (isEditing)
        {
            var res = await UserService.UpdateAddressAsync(EffectiveCustomerId, currentEditId, formReceiver, formPhone, formAddress, formIsDefault);
            alertSuccess = res.Success;
            alertMessage = res.Message;
        }
        else
        {
            var res = await UserService.AddAddressAsync(EffectiveCustomerId, formReceiver, formPhone, formAddress, formIsDefault);
            alertSuccess = res.Success;
            alertMessage = res.Message;
        }

        showModal = false;
        await LoadAddresses();
    }

    private async Task DeleteAddress(int addressId)
    {
        if (AuthService.CurrentUser == null) return;
        var res = await UserService.DeleteAddressAsync(EffectiveCustomerId, addressId);
        alertSuccess = res.Success;
        alertMessage = res.Message;
        await LoadAddresses();
    }

    private async Task SetDefault(int addressId)
    {
        if (AuthService.CurrentUser == null) return;
        var res = await UserService.SetDefaultAddressAsync(EffectiveCustomerId, addressId);
        alertSuccess = res.Success;
        alertMessage = res.Message;
        await LoadAddresses();
    }
}

