@attribute [Authorize(Roles = "Admin,Employee")]
@page "/admin/products/{id:int}/variants"
@layout Layout.AdminLayout
@inject IProductService ProductService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="mb-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/admin" class="text-decoration-none">Quản trị</a></li>
            <li class="breadcrumb-item"><a href="/admin/products" class="text-decoration-none">Sản phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">Quản lý biến thể</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="bi bi-layers me-2 text-primary"></i> Biến Thể Sản Phẩm: @(product?.ProductName ?? "")
            </h4>
            <p class="text-secondary small mb-0">
                Mã SP: <strong class="text-dark">@product?.ProductCode</strong> · Danh mục: @product?.Category?.CategoryName · Thương hiệu: @product?.Brand?.BrandName
            </p>
        </div>

        <div class="d-flex gap-2">
            <a href="/admin/products" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Danh sách SP
            </a>
            @if (AuthService.IsAdmin)
            {
                <button class="btn btn-dark btn-sm rounded-pill px-3 shadow-sm" @onclick="OpenAddModal">
                    <i class="bi bi-plus-lg me-1"></i> Thêm Biến Thể Mới
                </button>
            }
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(alertMessage))
{
    <div class="alert @(alertSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show rounded-3 small mb-4" role="alert">
        @alertMessage
        <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
    </div>
}

<div class="table-custom shadow-sm mb-5">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Đang tải biến thể...</p>
        </div>
    }
    else if (product == null)
    {
        <div class="text-center py-5 text-danger">Không tìm thấy sản phẩm.</div>
    }
    else if (!product.Variants.Any())
    {
        <div class="text-center py-5 text-secondary">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            Sản phẩm này chưa có biến thể size/màu nào.
            @if (AuthService.IsAdmin)
            {
                <div class="mt-2">
                    <button class="btn btn-dark btn-sm rounded-pill px-4" @onclick="OpenAddModal">
                        + Thêm Biến Thể Đầu Tiên
                    </button>
                </div>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Mã SKU</th>
                        <th>Kích Cỡ (Size)</th>
                        <th>Màu Sắc</th>
                        <th class="text-end">Giá Bán Niêm Yết</th>
                        <th class="text-center">Số Lượng Tồn</th>
                        <th class="text-center">Ngưỡng Báo Hết</th>
                        <th>Trạng Thái</th>
                        <th class="text-end" style="min-width: 140px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in product.Variants)
                    {
                        var isLow = v.StockQuantity <= v.LowStockThreshold;
                        <tr>
                            <td class="fw-bold font-monospace text-primary">@v.Sku</td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1">Size @v.Size</span>
                            </td>
                            <td>
                                <span class="fw-semibold">@v.Color</span>
                            </td>
                            <td class="text-end fw-bold text-dark">
                                @v.Price.ToString("N0") ₫
                            </td>
                            <td class="text-center">
                                <span class="badge @(isLow ? "bg-danger" : "bg-success") px-2 py-1">
                                    @v.StockQuantity
                                </span>
                            </td>
                            <td class="text-center text-muted">@v.LowStockThreshold</td>
                            <td>
                                @if (v.Status == ProductStatus.Selling)
                                {
                                    <span class="status-badge completed">Đang bán</span>
                                }
                                else
                                {
                                    <span class="status-badge cancelled">Ngừng bán</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (AuthService.IsAdmin)
                                {
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary" title="Sửa biến thể" @onclick="() => OpenEditModal(v)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-warning" title="Đổi trạng thái" @onclick="() => ToggleVariantStatus(v.VariantId)">
                                            <i class="bi bi-power"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="Xóa biến thể" @onclick="() => DeleteVariant(v.VariantId)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">Chỉ xem</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal Thêm / Sửa Biến Thể -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold">
                        @(isEditing ? "Chỉnh Sửa Biến Thể" : "Thêm Biến Thể Mới")
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mã SKU <span class="text-danger">*</span></label>
                        <input type="text" class="form-control font-monospace" placeholder="Ví dụ: AF1-07-WHT-40" @bind="formSku" />
                        <span class="text-muted" style="font-size: 0.725rem;">SKU phải là duy nhất trên toàn hệ thống</span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Kích cỡ (Size) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="Ví dụ: 39, 40, 41, 42..." @bind="formSize" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Màu sắc <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="Ví dụ: Trắng, Đen, Xám..." @bind="formColor" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Giá bán (₫) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" @bind="formPrice" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Ngưỡng báo sắp hết</label>
                            <input type="number" class="form-control" @bind="formLowThreshold" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Trạng thái kinh doanh</label>
                        <select class="form-select" @bind="formStatus">
                            <option value="@ProductStatus.Selling">Đang kinh doanh</option>
                            <option value="@ProductStatus.Discontinued">Ngừng kinh doanh</option>
                        </select>
                    </div>

                    <div class="small text-secondary">
                        <i class="bi bi-info-circle me-1"></i> Số lượng tồn kho được quản lý thông qua nghiệp vụ phiếu nhập kho và xuất kho tự động khi đặt hàng.
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="() => showModal = false">Hủy</button>
                    <button type="button" class="btn btn-dark btn-sm rounded-pill px-4" @onclick="SaveVariant">
                        Lưu Biến Thể
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Product? product;
    private bool isLoading = true;
    private string? alertMessage;
    private bool alertSuccess = true;

    private bool showModal = false;
    private bool isEditing = false;
    private int currentVariantId = 0;

    private string formSku = "";
    private string formSize = "";
    private string formColor = "";
    private decimal formPrice = 0;
    private int formLowThreshold = 5;
    private ProductStatus formStatus = ProductStatus.Selling;

    protected override async Task OnParametersSetAsync()
    {
        await LoadProduct();
    }

    private async Task LoadProduct()
    {
        isLoading = true;
        product = await ProductService.GetProductDetailAsync(Id, includeAllVariants: true);
        isLoading = false;
    }

    private void OpenAddModal()
    {
        isEditing = false;
        currentVariantId = 0;
        formSku = $"{product?.ProductCode}-";
        formSize = "40";
        formColor = "Trắng";
        formPrice = product?.Variants.FirstOrDefault()?.Price ?? 2000000;
        formLowThreshold = 5;
        formStatus = ProductStatus.Selling;
        showModal = true;
    }

    private void OpenEditModal(ProductVariant v)
    {
        isEditing = true;
        currentVariantId = v.VariantId;
        formSku = v.Sku;
        formSize = v.Size;
        formColor = v.Color;
        formPrice = v.Price;
        formLowThreshold = v.LowStockThreshold;
        formStatus = v.Status;
        showModal = true;
    }

    private async Task SaveVariant()
    {
        if (product == null) return;

        if (string.IsNullOrWhiteSpace(formSku) || string.IsNullOrWhiteSpace(formSize) || string.IsNullOrWhiteSpace(formColor))
        {
            alertSuccess = false;
            alertMessage = "SKU, Size và Màu sắc không được để trống.";
            return;
        }

        if (formPrice < 0)
        {
            alertSuccess = false;
            alertMessage = "Giá bán không được âm.";
            return;
        }

        if (isEditing)
        {
            var variant = new ProductVariant
            {
                VariantId = currentVariantId,
                ProductId = product.ProductId,
                Sku = formSku,
                Size = formSize,
                Color = formColor,
                Price = formPrice,
                LowStockThreshold = formLowThreshold,
                Status = formStatus
            };

            var res = await ProductService.UpdateVariantAsync(variant);
            alertSuccess = res.Success;
            alertMessage = res.Message;
        }
        else
        {
            var variant = new ProductVariant
            {
                ProductId = product.ProductId,
                Sku = formSku,
                Size = formSize,
                Color = formColor,
                Price = formPrice,
                StockQuantity = 0, // Nhập qua phiếu nhập kho
                LowStockThreshold = formLowThreshold,
                Status = formStatus
            };

            var res = await ProductService.AddVariantAsync(variant);
            alertSuccess = res.Success;
            alertMessage = res.Message;
        }

        showModal = false;
        await LoadProduct();
    }

    private async Task ToggleVariantStatus(int variantId)
    {
        var res = await ProductService.ToggleVariantStatusAsync(variantId);
        alertSuccess = res.Success;
        alertMessage = res.Message;
        await LoadProduct();
    }

    private async Task DeleteVariant(int variantId)
    {
        var res = await ProductService.DeleteVariantAsync(variantId);
        alertSuccess = res.Success;
        alertMessage = res.Message;
        await LoadProduct();
    }
}

