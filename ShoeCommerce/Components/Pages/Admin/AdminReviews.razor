@page "/admin/reviews"
@layout Layout.AdminLayout
@inject IReviewService ReviewService
@inject IProductService ProductService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="bi bi-star-fill text-warning me-2"></i> Quản Lý Đánh Giá & Nhận Xét
            </h4>
            <p class="text-secondary small mb-0">
                Xem phản hồi từ khách hàng đã mua và hoàn tất đơn hàng. @(AuthService.IsAdmin ? "Quản lý có thể kiểm duyệt và gỡ bỏ nhận xét không phù hợp." : "Nhân viên có quyền tra cứu đánh giá.")
            </p>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="ReloadData">
                <i class="bi bi-arrow-clockwise me-1"></i> Làm Mới
            </button>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(alertMessage))
{
    <div class="alert @(alertSuccess ? "alert-success" : "alert-warning") alert-dismissible fade show rounded-3 small mb-4" role="alert">
        @alertMessage
        <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
    </div>
}

<!-- Filters & Search -->
<div class="bg-white rounded-4 border p-3 mb-4 shadow-sm">
    <div class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light text-secondary"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="Tìm theo tên khách, nội dung đánh giá..." 
                       @bind="searchTerm" @bind:event="oninput" @onkeydown="HandleKeyDown" />
            </div>
        </div>

        <div class="col-md-3">
            <select class="form-select form-select-sm" @bind="selectedProductId" @bind:after="ApplyFilter">
                <option value="">-- Tất cả sản phẩm --</option>
                @if (products != null)
                {
                    @foreach (var p in products)
                    {
                        <option value="@p.ProductId">@p.ProductName</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-3">
            <select class="form-select form-select-sm" @bind="selectedRating" @bind:after="ApplyFilter">
                <option value="">-- Tất cả số sao --</option>
                <option value="5">⭐⭐⭐⭐⭐ (5 sao - Tuyệt vời)</option>
                <option value="4">⭐⭐⭐⭐ (4 sao - Tốt)</option>
                <option value="3">⭐⭐⭐ (3 sao - Trung bình)</option>
                <option value="2">⭐⭐ (2 sao - Chưa hài lòng)</option>
                <option value="1">⭐ (1 sao - Rất tệ)</option>
            </select>
        </div>

        <div class="col-md-2 text-end">
            <button class="btn btn-outline-secondary btn-sm w-100 rounded-pill" @onclick="ResetFilter">
                <i class="bi bi-x-circle me-1"></i> Xóa lọc
            </button>
        </div>
    </div>
</div>

<!-- Reviews Table -->
<div class="bg-white rounded-4 border shadow-sm overflow-hidden mb-4">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2 small">Đang tải danh sách đánh giá...</p>
        </div>
    }
    else if (reviews == null || reviews.Count == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-chat-square-dots text-secondary fs-1"></i>
            <h6 class="fw-bold text-dark mt-3">Không có đánh giá nào</h6>
            <p class="text-secondary small">Không tìm thấy đánh giá phù hợp với tiêu chí lọc.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small">
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th style="min-width: 220px;">Sản Phẩm</th>
                        <th style="min-width: 180px;">Khách Hàng</th>
                        <th style="min-width: 130px;">Đánh Giá</th>
                        <th>Nội Dung Nhận Xét</th>
                        <th style="min-width: 140px;">Thời Gian</th>
                        @if (AuthService.IsAdmin)
                        {
                            <th class="text-end" style="min-width: 90px;">Thao Tác</th>
                        }
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var r in reviews)
                    {
                        <tr>
                            <td class="text-secondary">@r.ReviewId</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@(string.IsNullOrEmpty(r.ProductThumbnail) ? "/images/placeholder-shoe.png" : r.ProductThumbnail)" 
                                         alt="@r.ProductName" class="rounded-3 border object-fit-cover" 
                                         style="width: 44px; height: 44px;" />
                                    <div>
                                        <a href="/product/@r.ProductId" target="_blank" class="fw-bold text-dark text-decoration-none">
                                            @r.ProductName
                                        </a>
                                        <div class="text-secondary" style="font-size: 0.75rem;">Mã SP: #@r.ProductId</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@r.CustomerName</div>
                                <div class="text-secondary" style="font-size: 0.75rem;">Mã KH: #@r.CustomerId</div>
                            </td>
                            <td>
                                <div class="text-warning">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= r.Rating)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-muted"></i>
                                        }
                                    }
                                </div>
                                <span class="badge bg-light text-dark border mt-1">@r.Rating / 5 sao</span>
                            </td>
                            <td>
                                <div class="text-wrap" style="max-width: 400px;">
                                    @r.Comment
                                </div>
                            </td>
                            <td>
                                <div class="text-dark">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                @if (r.UpdatedAt > r.CreatedAt.AddMinutes(1))
                                {
                                    <span class="text-secondary" style="font-size: 0.72rem;">(Đã sửa: @r.UpdatedAt.ToString("dd/MM/yyyy"))</span>
                                }
                            </td>
                            @if (AuthService.IsAdmin)
                            {
                                <td class="text-end">
                                    <button class="btn btn-outline-danger btn-sm rounded-pill px-2 py-1" 
                                            title="Xóa đánh giá không phù hợp"
                                            @onclick="() => PromptDelete(r)">
                                        <i class="bi bi-trash"></i> Gỡ
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-top gap-2">
            <span class="text-secondary small">
                Hiển thị <strong>@reviews.Count</strong> trên tổng số <strong>@totalCount</strong> đánh giá
            </span>
            <div class="d-flex gap-1">
                <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" 
                        disabled="@(currentPage <= 1)" 
                        @onclick="() => ChangePage(currentPage - 1)">
                    <i class="bi bi-chevron-left me-1"></i> Trước
                </button>
                <span class="btn btn-sm btn-light border rounded-pill px-3 disabled">
                    Trang @currentPage / @totalPages
                </span>
                <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" 
                        disabled="@(currentPage >= totalPages)" 
                        @onclick="() => ChangePage(currentPage + 1)">
                    Sau <i class="bi bi-chevron-right ms-1"></i>
                </button>
            </div>
        </div>
    }
</div>

<!-- Modal Xác Nhận Xóa Đánh Giá -->
@if (reviewToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Xác Nhận Gỡ Đánh Giá
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => reviewToDelete = null"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="mb-2">Bạn có chắc chắn muốn gỡ bỏ đánh giá sau đây của khách hàng không?</p>
                    <div class="p-3 bg-light rounded-3 border mb-3 small">
                        <div><strong>Khách hàng:</strong> @reviewToDelete.CustomerName</div>
                        <div><strong>Sản phẩm:</strong> @reviewToDelete.ProductName</div>
                        <div class="text-warning my-1">
                            @for (int i = 1; i <= reviewToDelete.Rating; i++)
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            <span class="text-dark ms-1">(@reviewToDelete.Rating sao)</span>
                        </div>
                        <div class="text-secondary italic">"@reviewToDelete.Comment"</div>
                    </div>
                    <p class="text-secondary small mb-0">Hành động này sẽ xóa vĩnh viễn đánh giá này khỏi cơ sở dữ liệu.</p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" @onclick="() => reviewToDelete = null">
                        Hủy Bỏ
                    </button>
                    <button type="button" class="btn btn-danger rounded-pill px-3" @onclick="ConfirmDelete">
                        Xác Nhận Xóa
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private List<ReviewViewDto>? reviews;
    private List<Product>? products;
    private int totalCount = 0;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)totalCount / pageSize));

    private string? searchTerm;
    private string selectedProductId = "";
    private string selectedRating = "";

    private ReviewViewDto? reviewToDelete;
    private string? alertMessage;
    private bool alertSuccess;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
        await LoadReviews();
    }

    private async Task LoadProducts()
    {
        try
        {
            var (pList, _) = await ProductService.GetAdminProductsAsync(pageSize: 1000);
            products = pList.OrderBy(p => p.ProductName).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading products: {ex.Message}");
        }
    }

    private async Task LoadReviews()
    {
        isLoading = true;
        try
        {
            int? pId = int.TryParse(selectedProductId, out var pidVal) ? pidVal : null;
            byte? rVal = byte.TryParse(selectedRating, out var rByte) ? rByte : null;

            var result = await ReviewService.GetAdminReviewsAsync(pId, rVal, searchTerm, currentPage, pageSize);
            reviews = result.Items;
            totalCount = result.TotalCount;
        }
        catch (Exception ex)
        {
            alertMessage = $"Lỗi khi tải dữ liệu đánh giá: {ex.Message}";
            alertSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilter()
    {
        currentPage = 1;
        await LoadReviews();
    }

    private async Task ResetFilter()
    {
        searchTerm = "";
        selectedProductId = "";
        selectedRating = "";
        currentPage = 1;
        await LoadReviews();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFilter();
        }
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage >= 1 && newPage <= totalPages)
        {
            currentPage = newPage;
            await LoadReviews();
        }
    }

    private async Task ReloadData()
    {
        await LoadReviews();
    }

    private void PromptDelete(ReviewViewDto item)
    {
        if (!AuthService.IsAdmin) return;
        reviewToDelete = item;
    }

    private async Task ConfirmDelete()
    {
        if (reviewToDelete == null || !AuthService.IsAdmin) return;

        var result = await ReviewService.DeleteReviewByAdminAsync(reviewToDelete.ReviewId);
        if (result.Success)
        {
            alertMessage = result.Message;
            alertSuccess = true;
            reviewToDelete = null;
            await LoadReviews();
        }
        else
        {
            alertMessage = result.Message;
            alertSuccess = false;
            reviewToDelete = null;
        }
    }
}

