@page "/admin/stock-documents"
@layout Layout.AdminLayout
@inject IInventoryService InventoryService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="bi bi-file-earmark-text me-2 text-primary"></i> Phiếu Nhập & Xuất Kho
            </h4>
            <p class="text-secondary small mb-0">Lịch sử toàn bộ các phiếu nhập hàng, xuất kho tự động và phiếu điều chỉnh tồn kho</p>
        </div>

        @if (AuthService.IsAdmin)
        {
            <a href="/admin/stock-documents/new" class="btn btn-dark btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Lập Phiếu Kho Mới
            </a>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(alertMessage))
{
    <div class="alert @(alertSuccess ? "alert-success" : "alert-warning") alert-dismissible fade show rounded-3 small mb-4" role="alert">
        @alertMessage
        <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
    </div>
}

<!-- Filters Bar -->
<div class="bg-white rounded-4 border p-3 mb-4 shadow-sm">
    <div class="row g-2 align-items-center">
        <div class="col-md-4">
            <select class="form-select form-select-sm" @bind="selectedType" @bind:after="ApplyFilter">
                <option value="">-- Tất cả loại phiếu kho --</option>
                <option value="PurchaseReceipt">Phiếu nhập hàng từ nhà cung cấp (PurchaseReceipt)</option>
                <option value="AdjustmentIn">Phiếu nhập điều chỉnh kho (AdjustmentIn)</option>
                <option value="AdjustmentOut">Phiếu xuất điều chỉnh kho (AdjustmentOut)</option>
                <option value="OrderIssue">Phiếu xuất tự động khi đặt hàng (OrderIssue)</option>
                <option value="OrderCancellationReceipt">Phiếu nhập tự động khi hủy đơn (OrderCancellationReceipt)</option>
            </select>
        </div>

        <div class="col-md-3">
            <select class="form-select form-select-sm" @bind="selectedStatus" @bind:after="ApplyFilter">
                <option value="">-- Trạng thái phiếu --</option>
                <option value="Draft">Nháp (Draft)</option>
                <option value="Confirmed">Đã xác nhận (Confirmed)</option>
            </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
            <button class="btn btn-sm btn-dark w-100" @onclick="ApplyFilter">Lọc</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFilter" title="Đặt lại">
                <i class="bi bi-arrow-counterclockwise"></i>
            </button>
        </div>
    </div>
</div>

<!-- Table -->
<div class="table-custom shadow-sm mb-4">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Đang tải danh sách phiếu kho...</p>
        </div>
    }
    else if (documents == null || !documents.Any())
    {
        <div class="text-center py-5 text-secondary">
            Không tìm thấy phiếu kho nào.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Mã Phiếu</th>
                        <th>Loại Phiếu</th>
                        <th>Lý Do / Ghi Chú</th>
                        <th>Nhà Cung Cấp / Đơn Hàng</th>
                        <th>Người Lập</th>
                        <th>Thời Gian Lập</th>
                        <th>Trạng Thái</th>
                        <th class="text-end" style="min-width: 140px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in documents)
                    {
                        <tr>
                            <td class="fw-bold font-monospace text-primary">@d.DocumentCode</td>
                            <td>
                                <span class="badge @GetBadgeForType(d.DocumentType)">
                                    @GetTypeName(d.DocumentType)
                                </span>
                            </td>
                            <td class="small text-secondary" style="max-width: 280px;">@d.Reason</td>
                            <td class="small">
                                @if (d.Supplier != null)
                                {
                                    <span><i class="bi bi-truck me-1"></i> @d.Supplier.SupplierName</span>
                                }
                                else if (d.OrderId != null)
                                {
                                    <span class="text-primary font-monospace"><i class="bi bi-receipt me-1"></i> Đơn #@d.OrderId</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="small">@(d.CreatedByUser?.FullName ?? "Hệ thống")</td>
                            <td class="small text-secondary">@d.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (d.DocumentStatus == StockDocumentStatus.Confirmed)
                                {
                                    <span class="badge bg-success">Đã xác nhận</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Bản nháp</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-info rounded-pill px-3 me-1" @onclick="() => ViewDetail(d.DocumentId)">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </button>
                                @if (AuthService.IsAdmin && d.DocumentStatus == StockDocumentStatus.Draft && d.OrderId == null)
                                {
                                    <button class="btn btn-sm btn-success rounded-pill px-2 me-1" title="Xác nhận phiếu & cập nhật tồn kho" @onclick="() => ConfirmDocument(d.DocumentId)">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Xóa phiếu nháp" @onclick="() => DeleteDraft(d.DocumentId)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center p-3 border-top bg-light">
                <span class="text-secondary small">
                    Trang <strong>@currentPage</strong> / <strong>@totalPages</strong> (Tổng @totalCount phiếu)
                </span>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">Trước</button>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        var pageIdx = i;
                        <li class="page-item @(pageIdx == currentPage ? "active" : "")">
                            <button class="page-link" @onclick="() => ChangePage(pageIdx)">@pageIdx</button>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Sau</button>
                    </li>
                </ul>
            </div>
        }
    }
</div>

<!-- Modal Chi Tiết Phiếu Kho -->
@if (showDetailModal && detailDoc != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold">Chi Tiết Phiếu Kho: @detailDoc.DocumentCode</h5>
                    <button type="button" class="btn-close" @onclick="() => showDetailModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-3 bg-light p-3 rounded-3 small">
                        <div class="col-sm-4 text-secondary">Loại phiếu:</div>
                        <div class="col-sm-8 fw-bold">@GetTypeName(detailDoc.DocumentType)</div>

                        <div class="col-sm-4 text-secondary">Trạng thái:</div>
                        <div class="col-sm-8">
                            <span class="badge @(detailDoc.DocumentStatus == StockDocumentStatus.Confirmed ? "bg-success" : "bg-warning text-dark")">
                                @detailDoc.DocumentStatus
                            </span>
                        </div>

                        <div class="col-sm-4 text-secondary">Lý do lập phiếu:</div>
                        <div class="col-sm-8">@detailDoc.Reason</div>

                        @if (detailDoc.Supplier != null)
                        {
                            <div class="col-sm-4 text-secondary">Nhà cung cấp:</div>
                            <div class="col-sm-8 fw-bold">@detailDoc.Supplier.SupplierName</div>
                        }

                        <div class="col-sm-4 text-secondary">Người lập / Thời gian:</div>
                        <div class="col-sm-8">@(detailDoc.CreatedByUser?.FullName ?? "Hệ thống") (lúc @detailDoc.CreatedAt.ToString("dd/MM/yyyy HH:mm"))</div>

                        @if (detailDoc.ConfirmedAt != null)
                        {
                            <div class="col-sm-4 text-secondary">Người xác nhận / Thời gian:</div>
                            <div class="col-sm-8">@(detailDoc.ConfirmedByUser?.FullName ?? "Hệ thống") (lúc @detailDoc.ConfirmedAt.Value.ToString("dd/MM/yyyy HH:mm"))</div>
                        }
                    </div>

                    <h6 class="fw-bold mb-2">Danh Sách Biến Thể Trong Phiếu (@detailDoc.Items.Count)</h6>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã SKU</th>
                                    <th>Sản Phẩm</th>
                                    <th>Kích Cỡ</th>
                                    <th>Màu Sắc</th>
                                    <th class="text-center">Số Lượng</th>
                                    <th class="text-end">Đơn Giá Vốn</th>
                                    <th>Ghi Chú</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in detailDoc.Items)
                                {
                                    <tr>
                                        <td class="font-monospace fw-bold text-primary">@(item.Variant?.Sku ?? "-")</td>
                                        <td class="fw-semibold">@(item.Variant?.Product?.ProductName ?? "-")</td>
                                        <td>Size @(item.Variant?.Size ?? "-")</td>
                                        <td>@(item.Variant?.Color ?? "-")</td>
                                        <td class="text-center fw-bold fs-6">@item.Quantity</td>
                                        <td class="text-end">@(item.UnitCost.HasValue ? item.UnitCost.Value.ToString("N0") + " ₫" : "-")</td>
                                        <td class="text-secondary small">@(item.Note ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-4" @onclick="() => showDetailModal = false">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<StockDocument>? documents;
    private bool isLoading = true;

    private string selectedType = "";
    private string selectedStatus = "";

    private int currentPage = 1;
    private int pageSize = 10;
    private int totalCount = 0;
    private int totalPages => (int)Math.Ceiling(totalCount / (double)pageSize);

    private string? alertMessage;
    private bool alertSuccess = true;

    private bool showDetailModal = false;
    private StockDocument? detailDoc;

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments();
    }

    private async Task LoadDocuments()
    {
        isLoading = true;
        StockDocumentType? type = Enum.TryParse<StockDocumentType>(selectedType, out var t) ? t : null;
        StockDocumentStatus? status = Enum.TryParse<StockDocumentStatus>(selectedStatus, out var s) ? s : null;

        var res = await InventoryService.GetStockDocumentsAsync(
            type: type,
            status: status,
            page: currentPage,
            pageSize: pageSize
        );

        documents = res.Items;
        totalCount = res.TotalCount;
        isLoading = false;
    }

    private async Task ApplyFilter()
    {
        currentPage = 1;
        await LoadDocuments();
    }

    private async Task ResetFilter()
    {
        selectedType = "";
        selectedStatus = "";
        currentPage = 1;
        await LoadDocuments();
    }

    private async Task ChangePage(int p)
    {
        if (p < 1 || p > totalPages) return;
        currentPage = p;
        await LoadDocuments();
    }

    private async Task ViewDetail(int docId)
    {
        detailDoc = await InventoryService.GetStockDocumentDetailAsync(docId);
        showDetailModal = true;
    }

    private async Task ConfirmDocument(int docId)
    {
        if (AuthService.CurrentUser == null) return;
        var res = await InventoryService.ConfirmStockDocumentAsync(docId, AuthService.CurrentUser.UserId);
        alertSuccess = res.Success;
        alertMessage = res.Message;
        await LoadDocuments();
    }

    private async Task DeleteDraft(int docId)
    {
        var res = await InventoryService.DeleteStockDocumentDraftAsync(docId);
        alertSuccess = res.Success;
        alertMessage = res.Message;
        await LoadDocuments();
    }

    private string GetTypeName(StockDocumentType type) => type switch
    {
        StockDocumentType.PurchaseReceipt => "Nhập hàng từ NCC",
        StockDocumentType.AdjustmentIn => "Nhập điều chỉnh",
        StockDocumentType.AdjustmentOut => "Xuất điều chỉnh",
        StockDocumentType.OrderIssue => "Xuất tự động (Đặt hàng)",
        StockDocumentType.OrderCancellationReceipt => "Nhập tự động (Hủy đơn)",
        _ => type.ToString()
    };

    private string GetBadgeForType(StockDocumentType type) => type switch
    {
        StockDocumentType.PurchaseReceipt => "bg-primary",
        StockDocumentType.AdjustmentIn => "bg-info text-dark",
        StockDocumentType.AdjustmentOut => "bg-warning text-dark",
        StockDocumentType.OrderIssue => "bg-secondary",
        StockDocumentType.OrderCancellationReceipt => "bg-success",
        _ => "bg-light text-dark"
    };
}

