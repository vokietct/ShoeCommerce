@page "/register"
@rendermode InteractiveServer
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="container py-5" style="max-width: 480px;">
    <div class="bg-white rounded-4 border p-4 p-md-5 shadow-sm">
        <div class="text-center mb-4">
            <a href="/" class="brand-logo text-decoration-none">
                shoestore<span class="dot">.</span>
            </a>
            <h4 class="fw-bold text-dark mt-3 mb-1">Đăng Ký Tài Khoản</h4>
            <p class="text-secondary small">Trở thành thành viên để nhận ngay ưu đãi giảm 100.000 ₫</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @errorMessage
            </div>
        }

        <EditForm Model="this" FormName="customer-register" OnValidSubmit="HandleRegister">
            <div class="mb-3">
                <label class="form-label small fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-secondary"><i class="bi bi-person"></i></span>
                    <input type="text" class="form-control" placeholder="Nguyễn Văn A" @bind="fullName" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Địa chỉ Email <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-secondary"><i class="bi bi-envelope"></i></span>
                    <input type="email" class="form-control" placeholder="name@example.com" @bind="email" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-secondary"><i class="bi bi-telephone"></i></span>
                    <input type="text" class="form-control" placeholder="0901234567" @bind="phone" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Mật khẩu (tối thiểu 6 ký tự) <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-secondary"><i class="bi bi-key"></i></span>
                    <input type="password" class="form-control" placeholder="••••••••" @bind="password" required />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label small fw-semibold">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-secondary"><i class="bi bi-shield-check"></i></span>
                    <input type="password" class="form-control" placeholder="••••••••" @bind="confirmPassword" required />
                </div>
            </div>

            <button type="submit" class="btn btn-dark-store w-100 py-2 rounded-pill fw-bold shadow-sm" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Đang tạo tài khoản...</span>
                }
                else
                {
                    <span>Tạo Tài Khoản Khách Hàng</span>
                }
            </button>
        </EditForm>

        <div class="text-center mt-4 text-secondary small">
            Đã có tài khoản?
            <a href="/login@(string.IsNullOrEmpty(ReturnUrl) ? "" : $"?returnUrl={ReturnUrl}")" class="fw-bold text-primary text-decoration-none ms-1">
                Đăng nhập ngay
            </a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string fullName = "";
    private string email = "";
    private string phone = "";
    private string password = "";
    private string confirmPassword = "";

    private bool isLoading = false;
    private string? errorMessage;

    private async Task HandleRegister()
    {
        errorMessage = null;

        if (password != confirmPassword)
        {
            errorMessage = "Xác nhận mật khẩu không trùng khớp.";
            return;
        }

        isLoading = true;
        var res = await AuthService.RegisterCustomerAsync(fullName, email, phone, password);
        isLoading = false;

        if (res.Success)
        {
            Navigation.NavigateTo(ReturnUrl ?? "/");
        }
        else
        {
            errorMessage = res.Message;
        }
    }
}
