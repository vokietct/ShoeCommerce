@page "/register"
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="container py-5" style="max-width: 480px;">
    <div class="bg-white rounded-4 border p-4 p-md-5 shadow-sm">
        <div class="text-center mb-4">
            <a href="/" class="brand-logo text-decoration-none">
                shoestore<span class="dot">.</span>
            </a>
            <h4 class="fw-bold text-dark mt-3 mb-1">Đăng Ký Tài Khoản</h4>
            <p class="text-secondary small">Tạo tài khoản để mua sắm và theo dõi đơn hàng</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @errorMessage
            </div>
        }

        <form method="post" action="/account/register" data-enhance="false">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <input type="hidden" name="portal" value="register" />
            <div class="mb-3">
                <label class="form-label small fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-secondary"><i class="bi bi-person"></i></span>
                    <input type="text" class="form-control" placeholder="Nguyễn Văn A" name="fullName" autocomplete="name" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Địa chỉ Email <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-secondary"><i class="bi bi-envelope"></i></span>
                    <input type="email" class="form-control" placeholder="name@example.com" name="email" autocomplete="email" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-secondary"><i class="bi bi-telephone"></i></span>
                    <input type="text" class="form-control" placeholder="0901234567" name="phone" autocomplete="tel" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Mật khẩu (tối thiểu 6 ký tự) <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-secondary"><i class="bi bi-key"></i></span>
                    <input type="password" class="form-control" placeholder="••••••••" name="password" autocomplete="new-password" required />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label small fw-semibold">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-secondary"><i class="bi bi-shield-check"></i></span>
                    <input type="password" class="form-control" placeholder="••••••••" name="confirmPassword" autocomplete="new-password" required />
                </div>
            </div>

            <button type="submit" class="btn btn-dark-store w-100 py-2 rounded-pill fw-bold shadow-sm">
                Tạo Tài Khoản
            </button>
        </form>

        <div class="text-center mt-4 text-secondary small">
            Đã có tài khoản?
            <a href="/login@(string.IsNullOrEmpty(ReturnUrl) ? "" : $"?returnUrl={Uri.EscapeDataString(ReturnUrl)}")" class="fw-bold text-primary text-decoration-none ms-1">
                Đăng nhập ngay
            </a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "error")]
    public string? errorMessage { get; set; }
}
