@page "/login"
@inject NavigationManager Navigation

<div class="container py-5" style="max-width: 460px;">
    <div class="bg-white rounded-4 border p-4 p-md-5 shadow-sm">
        <div class="text-center mb-4">
            <a href="/" class="brand-logo text-decoration-none">
                shoestore<span class="dot">.</span>
            </a>
            <h4 class="fw-bold text-dark mt-3 mb-1">Đăng Nhập Khách Hàng</h4>
            <p class="text-secondary small">Chào mừng bạn quay trở lại với ShoeStore</p>
        </div>

        @if (FormError == "invalid")
        {
            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3">
                Biểu mẫu đăng nhập không hợp lệ nên yêu cầu chưa được xử lý.
                <a href="@FreshLoginUrl" data-enhance-nav="false" class="alert-link">Tải biểu mẫu mới</a> rồi thử lại.
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @errorMessage
            </div>
        }

        <form method="post" action="/account/login" data-enhance="false">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <input type="hidden" name="portal" value="customer" />
            <div class="mb-3">
                <label class="form-label small fw-semibold">Địa chỉ Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-secondary"><i class="bi bi-envelope"></i></span>
                    <input type="email" class="form-control" placeholder="name@example.com" name="email" autocomplete="email" required />
                </div>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <label class="form-label small fw-semibold mb-0">Mật khẩu</label>
                </div>
                <div class="input-group mt-1">
                    <span class="input-group-text bg-light text-secondary"><i class="bi bi-key"></i></span>
                    <input type="password" class="form-control" placeholder="••••••••" name="password" autocomplete="current-password" required />
                </div>
            </div>

            <button type="submit" class="btn btn-dark-store w-100 py-2 rounded-pill fw-bold shadow-sm">
                Đăng Nhập
            </button>
        </form>

        <div class="text-center mt-4 text-secondary small">
            Chưa có tài khoản?
            <a href="/register@(string.IsNullOrEmpty(ReturnUrl) ? "" : $"?returnUrl={Uri.EscapeDataString(ReturnUrl)}")" class="fw-bold text-primary text-decoration-none ms-1">
                Đăng ký ngay
            </a>
        </div>

        <div class="text-center mt-3 pt-3 border-top text-secondary small">
            <a href="/admin/login" data-enhance-nav="false" class="text-secondary text-decoration-none">
                <i class="bi bi-shield-lock me-1"></i> Đăng nhập quản trị viên / nhân viên
            </a>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "error")]
    public string? errorMessage { get; set; }
    [SupplyParameterFromQuery(Name = "formError")]
    public string? FormError { get; set; }

    private string FreshLoginUrl =>
        $"/login?returnUrl={Uri.EscapeDataString(SessionSecurity.LocalReturnUrl(ReturnUrl))}";

    protected override void OnParametersSet()
    {
        if (HttpContext is null)
        {
            Navigation.Refresh(forceReload: true);
        }
    }
}
