@page "/order/{id:int}"
@inject IOrderService OrderService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/orders" class="text-decoration-none">Đơn hàng của tôi</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết đơn hàng</li>
        </ol>
    </nav>

    @if (!AuthService.IsAuthenticated || !AuthService.IsCustomer)
    {
        <div class="bg-white rounded-4 border p-5 text-center my-4">
            <i class="bi bi-person-lock fs-1 text-secondary mb-3 d-block"></i>
            <h5 class="fw-bold">Vui lòng đăng nhập</h5>
            <a href="/login" class="btn btn-dark rounded-pill px-4 mt-2">Đăng Nhập</a>
        </div>
    }
    else if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Đang tải chi tiết đơn hàng...</p>
        </div>
    }
    else if (order == null)
    {
        <div class="bg-white rounded-4 border p-5 text-center my-4">
            <i class="bi bi-question-circle fs-1 text-secondary mb-3 d-block"></i>
            <h4 class="fw-bold">Không tìm thấy đơn hàng</h4>
            <a href="/orders" class="btn btn-dark rounded-pill mt-3 px-4">Quay lại danh sách</a>
        </div>
    }
    else
    {
        <!-- Header & Action Bar -->
        <div class="bg-white rounded-4 border p-4 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h4 class="fw-bold text-dark mb-0">Đơn Hàng #@order.OrderCode</h4>
                    @GetStatusBadge(order.OrderStatus)
                </div>
                <div class="text-secondary small">
                    Đặt lúc: @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>

            <!-- Cancel Button if COD & Pending -->
            <div>
                @if (order.OrderStatus == OrderStatus.Pending && order.Payment?.PaymentMethod == PaymentMethod.COD)
                {
                    <button class="btn btn-outline-danger btn-sm rounded-pill px-3" @onclick="() => showCancelModal = true">
                        <i class="bi bi-x-circle me-1"></i> Hủy Đơn Hàng Này
                    </button>
                }
                else if (order.OrderStatus == OrderStatus.Pending && order.Payment?.PaymentMethod == PaymentMethod.BankTransfer)
                {
                    <span class="text-muted small">
                        <i class="bi bi-info-circle me-1"></i> Đơn chuyển khoản: Vui lòng liên hệ cửa hàng qua hotline 1900 6868 để yêu cầu hủy.
                    </span>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="alert alert-info alert-dismissible fade show rounded-3 small mb-4" role="alert">
                @statusMessage
                <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
            </div>
        }

        <!-- Details Grid -->
        <div class="row g-4 mb-4">
            <!-- Shipping Info -->
            <div class="col-md-6">
                <div class="bg-white rounded-4 border p-4 h-100">
                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-geo-alt me-1 text-danger"></i> Thông Tin Giao Hàng</h6>
                    <div class="small text-secondary d-flex flex-column gap-2">
                        <div>Người nhận: <strong class="text-dark">@order.ReceiverName</strong></div>
                        <div>Số điện thoại: <strong class="text-dark">@order.Phone</strong></div>
                        <div>Địa chỉ: <strong class="text-dark">@order.ShippingAddress</strong></div>
                        @if (!string.IsNullOrWhiteSpace(order.Note))
                        {
                            <div>Ghi chú: <span class="text-dark">@order.Note</span></div>
                        }
                    </div>
                </div>
            </div>

            <!-- Payment Info -->
            <div class="col-md-6">
                <div class="bg-white rounded-4 border p-4 h-100">
                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-credit-card me-1 text-primary"></i> Thông Tin Thanh Toán</h6>
                    <div class="small text-secondary d-flex flex-column gap-2">
                        <div>
                            Phương thức: <strong>@(order.Payment?.PaymentMethod == PaymentMethod.COD ? "Thanh toán khi nhận hàng (COD)" : "Chuyển khoản ngân hàng")</strong>
                        </div>
                        <div>
                            Trạng thái thanh toán:
                            <span class="badge @(order.Payment?.PaymentStatus == PaymentStatus.Paid ? "bg-success" : (order.Payment?.PaymentStatus == PaymentStatus.Cancelled ? "bg-danger" : "bg-warning text-dark"))">
                                @(order.Payment?.PaymentStatus switch
                                {
                                    PaymentStatus.Paid => "Đã thanh toán",
                                    PaymentStatus.Cancelled => "Đã hủy",
                                    _ => "Chưa thanh toán"
                                })
                            </span>
                        </div>
                        @if (order.Payment?.ConfirmedAt != null)
                        {
                            <div>Thời gian xác nhận: @order.Payment.ConfirmedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(order.Payment?.TransferReference))
                        {
                            <div>Mã đối soát chuyển khoản: <span class="text-dark font-monospace">@order.Payment.TransferReference</span></div>
                        }
                        @if (order.OrderStatus == OrderStatus.Cancelled && !string.IsNullOrWhiteSpace(order.CancelReason))
                        {
                            <div class="text-danger mt-1">Lý do hủy: @order.CancelReason</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Items Table -->
        <div class="bg-white rounded-4 border overflow-hidden mb-4">
            <div class="p-3 bg-light border-bottom fw-bold text-dark">
                Danh Sách Sản Phẩm Trong Đơn
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Mã SKU</th>
                            <th>Kích cỡ</th>
                            <th>Màu sắc</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in order.OrderDetails)
                        {
                            <tr>
                                <td class="fw-semibold">@d.ProductNameSnapshot</td>
                                <td class="text-secondary font-monospace">@d.SkuSnapshot</td>
                                <td>@d.SizeSnapshot</td>
                                <td>@d.ColorSnapshot</td>
                                <td class="text-center">@d.Quantity</td>
                                <td class="text-end">@d.UnitPrice.ToString("N0") ₫</td>
                                <td class="text-end fw-bold">@((d.Quantity * d.UnitPrice).ToString("N0")) ₫</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="border-top">
                        <tr>
                            <td colspan="6" class="text-end text-secondary">Tạm tính tiền hàng:</td>
                            <td class="text-end fw-semibold">@order.TotalAmount.ToString("N0") ₫</td>
                        </tr>
                        @if (order.DiscountAmount > 0)
                        {
                            <tr class="text-success">
                                <td colspan="6" class="text-end">Giảm giá (@(order.PromoCodeSnapshot ?? "Khuyến mãi")):</td>
                                <td class="text-end fw-bold">-@order.DiscountAmount.ToString("N0") ₫</td>
                            </tr>
                        }
                        <tr>
                            <td colspan="6" class="text-end fw-bold text-dark fs-6">Tổng thanh toán:</td>
                            <td class="text-end fw-bold text-danger fs-5">
                                @((order.TotalAmount - order.DiscountAmount).ToString("N0")) ₫
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Order Status History Timeline -->
        <div class="bg-white rounded-4 border p-4">
            <h6 class="fw-bold text-dark mb-3">
                <i class="bi bi-clock-history me-1"></i> Lịch Sử Trạng Thái Đơn Hàng
            </h6>
            @if (order.StatusHistories != null && order.StatusHistories.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var h in order.StatusHistories.OrderByDescending(x => x.ChangedAt))
                    {
                        <div class="d-flex align-items-start gap-3 small border-bottom pb-2">
                            <span class="badge @(h.NewStatus == OrderStatus.Completed ? "bg-success" : (h.NewStatus == OrderStatus.Cancelled ? "bg-danger" : "bg-primary")) mt-1">
                                @h.NewStatus
                            </span>
                            <div class="flex-grow-1">
                                <div class="text-dark fw-semibold">
                                    @(string.IsNullOrWhiteSpace(h.Note) ? $"Chuyển trạng thái sang {h.NewStatus}" : h.Note)
                                </div>
                                <div class="text-muted" style="font-size: 0.75rem;">
                                    Bởi: @(h.ChangedByUser?.FullName ?? "Hệ thống") · Lúc: @h.ChangedAt.ToString("dd/MM/yyyy HH:mm:ss")
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-secondary small mb-0">Chưa có lịch sử thay đổi trạng thái.</p>
            }
        </div>
    }
</div>

<!-- Cancel Order Modal -->
@if (showCancelModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold text-danger">
                        <i class="bi bi-exclamation-triangle me-1"></i> Hủy Đơn Hàng
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showCancelModal = false"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-secondary mb-3">
                        Bạn có chắc chắn muốn hủy đơn hàng <strong>#@order?.OrderCode</strong>? Khi hủy, số lượng tồn kho của các sản phẩm sẽ được tự động hoàn lại vào kho chung của cửa hàng.
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Lý do hủy đơn <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="3" placeholder="Nhập lý do hủy (ví dụ: Thay đổi địa chỉ nhận, đặt nhầm size...)" @bind="cancelReasonInput"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="() => showCancelModal = false">Đóng</button>
                    <button type="button" class="btn btn-danger btn-sm rounded-pill px-3" @onclick="HandleCancelOrder" disabled="@isCancelling">
                        @if (isCancelling)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Xác Nhận Hủy Đơn
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Order? order;
    private bool isLoading = true;
    private string? statusMessage;

    private bool showCancelModal = false;
    private string cancelReasonInput = "";
    private bool isCancelling = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrderDetail();
    }

    private async Task LoadOrderDetail()
    {
        if (AuthService.IsAuthenticated && AuthService.IsCustomer && AuthService.CurrentUser != null)
        {
            isLoading = true;
            order = await OrderService.GetCustomerOrderDetailAsync(AuthService.CurrentUser.UserId, Id);
            isLoading = false;
        }
    }

    private async Task HandleCancelOrder()
    {
        if (string.IsNullOrWhiteSpace(cancelReasonInput))
        {
            statusMessage = "Vui lòng nhập lý do hủy đơn hàng.";
            return;
        }

        if (AuthService.CurrentUser == null || order == null) return;

        isCancelling = true;
        var res = await OrderService.CancelOrderCustomerAsync(AuthService.CurrentUser.UserId, order.OrderId, cancelReasonInput);
        isCancelling = false;

        showCancelModal = false;
        statusMessage = res.Message;
        await LoadOrderDetail();
    }

    private RenderFragment GetStatusBadge(OrderStatus status) => builder =>
    {
        var (cls, label) = status switch
        {
            OrderStatus.Pending => ("bg-warning text-dark", "Chờ xác nhận"),
            OrderStatus.Confirmed => ("bg-info text-white", "Đã xác nhận"),
            OrderStatus.Shipping => ("bg-primary text-white", "Đang giao"),
            OrderStatus.Completed => ("bg-success text-white", "Hoàn tất"),
            OrderStatus.Cancelled => ("bg-danger text-white", "Đã hủy"),
            _ => ("bg-secondary text-white", status.ToString())
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge {cls} px-2 py-1");
        builder.AddContent(2, label);
        builder.CloseElement();
    };
}

