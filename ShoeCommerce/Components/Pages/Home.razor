@page "/"
@inject IProductService ProductService
@inject ICategoryBrandService CategoryBrandService
@inject ICartService CartService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="container py-4">
    <!-- Hero Banner -->
    <div class="rounded-4 overflow-hidden position-relative mb-5" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #334155 100%); min-height: 400px; color: white;">
        <div class="row align-items-center h-100 p-4 p-lg-5">
            <div class="col-lg-7">
                <span class="badge bg-primary px-3 py-2 rounded-pill mb-3 text-uppercase fw-semibold" style="letter-spacing: 0.05em;">
                    Bộ Sưu Tập Mới 2026
                </span>
                <h1 class="display-4 fw-extrabold mb-3" style="letter-spacing: -0.03em; font-weight: 800;">
                    BƯỚC ĐI MỚI,<br/>CẢM HỨNG MỚI.
                </h1>
                <p class="lead text-light opacity-75 mb-4" style="max-width: 520px;">
                    Khám phá những mẫu giày thể thao, chạy bộ và thời trang chính hãng đỉnh cao từ Nike, Adidas, Puma, New Balance. Tối ưu hiệu năng, phong cách bất tận.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="/products" class="btn btn-primary btn-lg rounded-pill px-4 fw-semibold shadow-sm">
                        Khám Phá Ngay <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                    <a href="/products?category=2" class="btn btn-outline-light btn-lg rounded-pill px-4 fw-semibold">
                        Giày Chạy Bộ
                    </a>
                </div>
            </div>
            <div class="col-lg-5 text-center mt-4 mt-lg-0">
                <img src="/images/products/nike_air_force_1.png" alt="Hero Shoe" class="img-fluid" style="max-height: 320px; filter: drop-shadow(0 20px 30px rgba(0,0,0,0.5)); transform: rotate(-12deg);" />
            </div>
        </div>
    </div>

    <!-- Value Propositions -->
    <div class="row g-3 mb-5 text-center">
        <div class="col-md-3 col-6">
            <div class="bg-white p-3 rounded-3 border h-100 d-flex flex-column align-items-center justify-content-center">
                <i class="bi bi-shield-check text-primary fs-2 mb-2"></i>
                <h6 class="fw-bold mb-1">100% Chính Hãng</h6>
                <p class="text-secondary small mb-0">Cam kết nguồn gốc xuất xứ rõ ràng</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="bg-white p-3 rounded-3 border h-100 d-flex flex-column align-items-center justify-content-center">
                <i class="bi bi-truck text-success fs-2 mb-2"></i>
                <h6 class="fw-bold mb-1">Giao Hàng Toàn Quốc</h6>
                <p class="text-secondary small mb-0">Hỗ trợ thanh toán COD an tâm</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="bg-white p-3 rounded-3 border h-100 d-flex flex-column align-items-center justify-content-center">
                <i class="bi bi-arrow-left-right text-warning fs-2 mb-2"></i>
                <h6 class="fw-bold mb-1">Đổi Size Dễ Dàng</h6>
                <p class="text-secondary small mb-0">Hỗ trợ tư vấn size chuẩn xác</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="bg-white p-3 rounded-3 border h-100 d-flex flex-column align-items-center justify-content-center">
                <i class="bi bi-headset text-info fs-2 mb-2"></i>
                <h6 class="fw-bold mb-1">Hỗ Trợ 24/7</h6>
                <p class="text-secondary small mb-0">Tận tâm phục vụ quý khách</p>
            </div>
        </div>
    </div>

    <!-- Categories Section -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-1">Danh Mục Sản Phẩm</h3>
                <p class="text-secondary small mb-0">Tìm kiếm nhanh theo phong cách và nhu cầu của bạn</p>
            </div>
            <a href="/products" class="text-decoration-none fw-semibold small">
                Xem tất cả <i class="bi bi-chevron-right"></i>
            </a>
        </div>

        <div class="row g-3">
            @if (categories != null)
            {
                @foreach (var cat in categories)
                {
                    <div class="col-md-4 col-6">
                        <a href="/products?category=@cat.CategoryId" class="card border-0 rounded-4 overflow-hidden text-decoration-none shadow-sm text-dark h-100 bg-white p-3 d-flex flex-row align-items-center gap-3" style="transition: transform 0.2s;">
                            <div class="bg-light rounded-3 p-3 text-center" style="width: 60px; height: 60px;">
                                <i class="bi bi-tag-fill fs-4 text-primary"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">@cat.CategoryName</h6>
                                <span class="badge bg-light text-secondary border small">@cat.Products.Count sản phẩm</span>
                            </div>
                        </a>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Featured Products Grid -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-1">Sản Phẩm Nổi Bật</h3>
                <p class="text-secondary small mb-0">Những đôi giày được yêu thích và đánh giá cao nhất</p>
            </div>
            <a href="/products" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                Xem tất cả sản phẩm
            </a>
        </div>

        <div class="row g-4">
            @if (featuredProducts != null)
            {
                @foreach (var prod in featuredProducts)
                {
                    var sellingVars = prod.Variants.Where(v => v.Status == ProductStatus.Selling).ToList();
                    var minPrice = sellingVars.Any() ? sellingVars.Min(v => v.Price) : 0;
                    var avgRating = prod.Reviews.Any() ? prod.Reviews.Average(r => (double)r.Rating) : 0.0;

                    <div class="col-lg-3 col-md-4 col-6">
                        <div class="product-card">
                            <a href="/product/@prod.ProductId" class="product-thumb-wrapper text-decoration-none">
                                <img src="@(prod.ThumbnailUrl ?? "/images/products/nike_air_force_1.png")" alt="@prod.ProductName" />
                                <span class="product-badge-brand">@(prod.Brand?.BrandName ?? "Chính hãng")</span>
                            </a>
                            <div class="product-info-body">
                                <span class="text-secondary small mb-1">@(prod.Category?.CategoryName ?? "Giày")</span>
                                <a href="/product/@prod.ProductId" class="product-title text-decoration-none">
                                    @prod.ProductName
                                </a>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div class="star-rating">
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <span class="star-score">@avgRating.ToString("0.0")</span>
                                    </div>
                                    <span class="text-muted small">(@prod.Reviews.Count)</span>
                                </div>
                                <div class="product-meta">
                                    <div class="product-price">
                                        @minPrice.ToString("N0") ₫
                                    </div>
                                    <a href="/product/@prod.ProductId" class="btn btn-sm btn-outline-dark rounded-circle" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Promo Banner Box -->
    <div class="bg-dark text-white rounded-4 p-4 p-md-5 my-5 d-flex flex-column flex-md-row justify-content-between align-items-center gap-4">
        <div>
            <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold mb-2">MÃ ƯU ĐÃI THÀNH VIÊN</span>
            <h3 class="fw-bold mb-2">Nhập mã <span class="text-warning">CHAO100</span> giảm ngay 100.000 ₫</h3>
            <p class="text-light opacity-75 mb-0">Áp dụng cho đơn hàng từ 1.500.000 ₫ khi thanh toán trên website.</p>
        </div>
        <div>
            <a href="/products" class="btn btn-warning btn-lg rounded-pill px-4 fw-bold text-dark shadow">
                Mua Sắm Ngay
            </a>
        </div>
    </div>

    <!-- Brand Logos -->
    <div class="text-center py-4">
        <h6 class="text-secondary text-uppercase fw-bold small mb-4" style="letter-spacing: 0.1em;">Thương Hiệu Hợp Tác Phân Phối</h6>
        <div class="d-flex flex-wrap justify-content-center align-items-center gap-4 gap-md-5 opacity-75">
            <span class="fs-4 fw-bold">NIKE</span>
            <span class="fs-4 fw-bold">ADIDAS</span>
            <span class="fs-4 fw-bold">PUMA</span>
            <span class="fs-4 fw-bold">CONVERSE</span>
            <span class="fs-4 fw-bold">VANS</span>
            <span class="fs-4 fw-bold">NEW BALANCE</span>
        </div>
    </div>
</div>

@code {
    private List<Category>? categories;
    private List<Product>? featuredProducts;

    protected override async Task OnInitializedAsync()
    {
        categories = await CategoryBrandService.GetAllCategoriesAsync();
        featuredProducts = await ProductService.GetFeaturedProductsAsync(8);
    }
}
